# LossFunction configuration template.
# Copy to `.env` (gitignored) and fill in values. Never commit real secrets.

# paper (default) | live — live also requires LIVE_TRADING_CONFIRMED=true
TRADING_MODE=paper
LIVE_TRADING_CONFIRMED=false

# Paper-mode broker: memory (in-process, default) | kis (KIS 모의투자 domain)
PAPER_BACKEND=memory

# Demo loop: synthetic quotes/orders on the memory paper backend (visible on the status page)
DEMO_LOOP=false

# Symbol universe: comma-separated 6-digit codes (invalid codes refuse to boot).
# Default: 005930,035420,069500
WATCHLIST=

# KIS Open API domain: mock (모의투자, default) | real
# Guard: TRADING_MODE=paper + PAPER_BACKEND=kis + real is REFUSED — a paper
# label must never carry real credentials to the real market.
KIS_ENVIRONMENT=mock

# KIS Open API credentials (real or mock, depending on the KIS domain used)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NUMBER=

# SQLite database file (single file, WAL mode — no server needed)
DATABASE_PATH=data/lossfunction.db

# Alerting (webhook opt-in; console alerts are always on)
ALERT_WEBHOOK_URL=
ALERT_MIN_INTERVAL_SECONDS=30
